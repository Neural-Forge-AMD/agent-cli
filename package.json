{
  "name": "@pikaa-ai/pikaa",
  "version": "0.4.1",
  "description": "PIKAA CLI - AI coding agent that runs locally in your terminal.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pikaa": "./bin/pikaa.js",
    "groupy": "./bin/pikaa.js"
  },
  "type": "module",
  "files": [
    "dist/index.js",
    "dist/cli.js",
    "bin",
    "templates",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target=bun && bun build ./src/cli/index.ts --outfile ./dist/cli.js --target=bun",
    "build:exe": "bun build ./src/cli/index.ts --compile --outfile pikaa.exe",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "publish:packages": "bun run scripts/publish-packages.ts",
    "release:prepare": "bun run scripts/prepare-release.ts",
    "build": "bun run build:js && bun run build:exe",
    "prepublishOnly": "bun run build:js"
  },
  "optionalDependencies": {
    "@pikaa-ai/pikaa-linux-x64": "0.4.1",
    "@pikaa-ai/pikaa-linux-x64-musl": "0.4.1",
    "@pikaa-ai/pikaa-linux-arm64": "0.4.1",
    "@pikaa-ai/pikaa-linux-arm64-musl": "0.4.1",
    "@pikaa-ai/pikaa-darwin-x64": "0.4.1",
    "@pikaa-ai/pikaa-darwin-arm64": "0.4.1",
    "@pikaa-ai/pikaa-windows-x64": "0.4.1",
    "@pikaa-ai/pikaa-windows-arm64": "0.4.1"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "codex",
    "claude-code",
    "cli",
    "agentic",
    "sub-agents",
    "mcp",
    "worktree"
  ],
  "author": "Mesosfer",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "^5.7.0"
  }
}

